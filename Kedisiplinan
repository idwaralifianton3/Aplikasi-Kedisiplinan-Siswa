  function renderGuruRekap(){
    const kelas = grKelas.value || KELAS_LIST[0];
    grKelas.value = kelas;
    const container = document.getElementById('guru-rekap-table');
    const titleEl = document.getElementById('print-title-guru');

    if(!grDari.value || !grSampai.value){
      titleEl.textContent = '';
      container.innerHTML = '<div class="empty">Pilih tanggal "Dari" dan "Sampai" untuk melihat rekap.</div>';
      return;
    }
    if(grDari.value > grSampai.value){
      container.innerHTML = '<div class="empty">Tanggal "Dari" tidak boleh lebih besar dari "Sampai".</div>';
      return;
    }

    titleEl.textContent = 'Rekap Checklist Guru — ' + kelas + ' — ' + guruRekapRangeLabel();

    const days = dateRangeList(grDari.value, grSampai.value);
    const totalTasks = GURU_TASKS.length;
    let sumPct = 0;
    let daysCounted = 0;

    let html = '';
    days.forEach(day=>{
      const doneIds = new Set(
        guruLog.filter(r=>r.kelas===kelas && r.tanggal===day).map(r=>r.taskId)
      );
      const doneCount = GURU_TASKS.filter(t=>doneIds.has(t.id)).length;
      const pct = Math.round((doneCount/totalTasks)*100);
      sumPct += pct;
      daysCounted++;
      const pctClass = pct < 60 ? 'low' : '';
      html += `<div class="day-block">
        <div class="day-head">
          <strong>${fmtTanggalPendek(day)}</strong>
          <span class="pct-badge ${pctClass}">${doneCount}/${totalTasks} &middot; ${pct}%</span>
        </div>`;
      GURU_TASKS.forEach(t=>{
        const done = doneIds.has(t.id);
        html += `<div class="task-line ${done?'done':'miss'}">
          <span class="mark">${done?'✔':'✘'}</span><span>${t.label}</span>
        </div>`;
      });
      html += `</div>`;
    });

    const avgPct = daysCounted>0 ? Math.round(sumPct/daysCounted) : 0;
    html += `<div class="summary-row"><span>Rata-rata persentase (${daysCounted} hari)</span><span class="pct-badge ${avgPct<60?'low':''}">${avgPct}%</span></div>`;

    container.innerHTML = html;
  }

  // Unduh PDF landscape langsung — tidak bergantung pada pengaturan orientasi kertas
