  const WA_ONLY_ON_DAY = { infaq: 5, kuku: 5, catering: 6 }; // 0=Minggu ... 5=Jumat, 6=Sabtu
  function categoriesForWaDay(tanggal){
    const dow = new Date(tanggal+'T00:00:00').getDay();
    return CATEGORIES.filter(c => !(c.id in WA_ONLY_ON_DAY) || WA_ONLY_ON_DAY[c.id] === dow);
