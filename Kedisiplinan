  function todayStr(){
    const d = new Date();
    return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  }
  function fmtTanggalPanjang(dateStr){
    const days = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
    const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    const d = new Date(dateStr+'T00:00:00');
    return days[d.getDay()]+', '+d.getDate()+' '+months[d.getMonth()]+' '+d.getFullYear();
  }
  function fmtTanggalPendek(dateStr){
    const months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    const d = new Date(dateStr+'T00:00:00');
    return d.getDate()+' '+months[d.getMonth()]+' '+d.getFullYear();
  }
  function uid(prefix){ return prefix+'_'+Date.now()+Math.random().toString(36).slice(2,7); }
  function dateRangeList(dari, sampai){
    const out = [];
    let cur = new Date(dari+'T00:00:00');
    const end = new Date(sampai+'T00:00:00');
    while(cur <= end){
      out.push(cur.getFullYear()+'-'+String(cur.getMonth()+1).padStart(2,'0')+'-'+String(cur.getDate()).padStart(2,'0'));
      cur.setDate(cur.getDate()+1);
    }
    return out;
  }

