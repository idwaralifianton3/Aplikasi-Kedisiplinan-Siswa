  function buildWaText(kelas, tanggal){
    const list = records.filter(r=>r.kelas===kelas && r.tanggal===tanggal);
    const header = `📋 *Rekap Kedisiplinan ${kelas}*\n\n📅 *${fmtTanggalPanjang(tanggal)}*\n`;

    let body = '';
    categoriesForWaDay(tanggal).forEach(c=>{
      const names = list.filter(r=>r.category===c.id).map(r=>r.name);
      body += `\n${c.emoji} *${c.label}*\n`;
      body += names.length===0
        ? `🌟 ${c.positiveMsg} 👏🏻✨\n`
        : listBlock(names);
    });

    const closing = `\n🌷 Semoga besok kita bisa lebih disiplin, bertanggung jawab, dan mempersiapkan segala keperluan dengan lebih baik. ✨`;
    return header + body + closing;
  }
  function listBlock(names){
    if(names.length===1) return `• ${names[0]}\n`;
    return names.map((n,i)=>`${i+1}. ${n}`).join('\n') + '\n';
  }

