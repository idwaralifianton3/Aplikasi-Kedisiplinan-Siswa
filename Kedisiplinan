  // status centang untuk slot (kelas+tanggal+kategori) yang sedang aktif — sumber kebenaran tunggal,
  // tidak lagi dibaca ulang dari DOM setiap render supaya tidak hilang saat difilter pencarian
  let checkedState = new Set();

  async function renderChecklist(resetSelection){
    const {kelas, tanggal, category} = currentContext();
    records = await fetchRecords(); // ambil data terbaru supaya sinkron dgn guru lain
    const existingIds = new Set(
      records.filter(r=>r.kelas===kelas && r.tanggal===tanggal && r.category===category).map(r=>r.studentId)
    );
    if(resetSelection){
      checkedState = new Set(existingIds); // masuk slot baru -> mulai dari data tersimpan di server
    }
    const q = inCari.value.trim().toLowerCase();
    const list = students
      .filter(s=>s.kelas===kelas)
      .filter(s=> !q || s.name.toLowerCase().includes(q))
      .sort((a,b)=>a.name.localeCompare(b.name));

    if(list.length===0){
      checklistEl.innerHTML = '<div class="empty">Belum ada siswa di kelas ini. Tambahkan lewat kotak di bawah, atau lengkapi di tab Kelola Siswa.</div>';
      updateCountPill();
      return;
    }
    checklistEl.innerHTML = list.map(s=>{
      const already = existingIds.has(s.id);
      const checked = checkedState.has(s.id);
      return `<label class="sc-row ${already?'already':''}" data-id="${s.id}">
        <input type="checkbox" value="${s.id}" ${checked?'checked':''}>
        <span>${s.name}</span>
        ${already?'<span class="tag-existing">Sudah tercatat</span>':''}
      </label>`;
    }).join('');
    checklistEl.querySelectorAll('input[type=checkbox]').forEach(cb=>{
      cb.addEventListener('change', ()=>{
        if(cb.checked) checkedState.add(cb.value); else checkedState.delete(cb.value);
        updateCountPill();
        // setelah mencentang siswa hasil pencarian, blok teks di kotak cari
        // supaya bisa langsung dihapus sekali klik/tekan
        if(cb.checked && inCari.value.trim() !== ''){
          inCari.focus();
          inCari.select();
        }
      });
    });
    updateCountPill();
  }

  let lastContext = null;

  async function autoSaveCurrentSelection(){
    if(!lastContext) return;
    const checkedIds = new Set(checkedState);
    const {kelas, tanggal, category} = lastContext;
    const freshRecords = await fetchRecords();
    const sameSlot = r => r.kelas===kelas && r.tanggal===tanggal && r.category===category;
    const otherRecords = freshRecords.filter(r=>!sameSlot(r));
    const existingSlotRecords = freshRecords.filter(sameSlot);
    const existingIds = new Set(existingSlotRecords.map(r=>r.studentId));

    const newOnes = [];
    checkedIds.forEach(sid=>{
      if(!existingIds.has(sid)){
        const st = students.find(s=>s.id===sid);
        if(st) newOnes.push({id: uid('rec'), studentId: sid, name: st.name, kelas, tanggal, category, catatan: ''});
      }
    });
    const keptExisting = existingSlotRecords.filter(r=>checkedIds.has(r.studentId));

    if(newOnes.length>0 || keptExisting.length!==existingSlotRecords.length){
      const merged = [...otherRecords, ...keptExisting, ...newOnes];
      await saveRecordsArr(merged);
    }
  }

