  function exportGuruRekapPdf(kelas, days){
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation:'landscape', unit:'mm', format:'a4' });
    const dayNums = days.map(d=> new Date(d+'T00:00:00').getDate());
    const totalTasks = GURU_TASKS.length;
    const doneCountPerDay = days.map(()=>0);

    const body = GURU_TASKS.map(t=>{
      let doneDaysForTask = 0;
      const row = [t.label];
      days.forEach((day, idx)=>{
        const done = guruLog.some(r=>r.kelas===kelas && r.tanggal===day && r.taskId===t.id);
        if(done){ doneDaysForTask++; doneCountPerDay[idx]++; }
        row.push(done ? 'V' : 'X');
      });
      const pct = days.length ? Math.round((doneDaysForTask/days.length)*100) : 0;
      row.push(pct+'%');
      return row;
    });

    let sumDailyPct = 0;
    const footRow = ['% Harian'];
    doneCountPerDay.forEach(cnt=>{
      const dPct = totalTasks ? Math.round((cnt/totalTasks)*100) : 0;
      sumDailyPct += dPct;
      footRow.push(dPct+'%');
    });
    const overallPct = days.length ? Math.round(sumDailyPct/days.length) : 0;
    footRow.push(overallPct+'%');

    doc.setFont('helvetica','bold');
    doc.setFontSize(13);
    doc.text('Rekap Checklist Guru - ' + kelas, 10, 12);
    doc.setFont('helvetica','normal');
    doc.setFontSize(9);
    doc.text(guruRekapRangeLabel(), 10, 18);

    const colStyles = { 0:{ halign:'left', cellWidth:55 } };
    dayNums.forEach((_,i)=>{ colStyles[i+1] = { cellWidth: 6.8 }; });
    colStyles[dayNums.length+1] = { cellWidth: 13, fontStyle:'bold' };

    doc.autoTable({
      head: [['Tugas', ...dayNums.map(String), '%']],
      body,
      foot: [footRow],
      startY: 22,
      theme: 'grid',
      styles: { fontSize:7, cellPadding:1.2, halign:'center', valign:'middle', lineColor:[201,190,158], lineWidth:0.15 },
      headStyles: { fillColor:[196,143,1], textColor:255, fontStyle:'bold' },
      footStyles: { fillColor:[244,238,218], textColor:[19,35,61], fontStyle:'bold' },
      columnStyles: colStyles,
      margin:{ left:8, right:8 }
    });

    doc.save(`Rekap_Checklist_${kelas.replace(/\s+/g,'_')}_${days[0]}_${days[days.length-1]}.pdf`);
  }

  grKelas.addEventListener('change', renderGuruRekap);
  grDari.addEventListener('change', renderGuruRekap);
  grSampai.addEventListener('change', renderGuruRekap);
  document.getElementById('btn-cetak-guru').addEventListener('click', ()=>{
    if(!grDari.value || !grSampai.value || grDari.value > grSampai.value){
      alert('Pilih rentang tanggal "Dari" dan "Sampai" yang valid dulu.');
      return;
    }
    if(!window.jspdf || !window.jspdf.jsPDF){
      alert('Library PDF belum berhasil dimuat. Pastikan perangkat terhubung internet, lalu muat ulang halaman dan coba lagi.');
      return;
    }
    const kelas = grKelas.value || KELAS_LIST[0];
    const days = dateRangeList(grDari.value, grSampai.value);
    try{
      exportGuruRekapPdf(kelas, days);
    }catch(e){
      console.error('gagal membuat PDF', e);
      alert('Gagal membuat PDF: ' + e.message);
    }
  });

  // ---------- KELOLA SISWA ----------
  function renderStudentList(){
    const kelas = document.getElementById('s-kelas').value;
    const list = students.filter(s=>s.kelas===kelas).sort((a,b)=>a.name.localeCompare(b.name));
    const container = document.getElementById('student-list');
    if(list.length===0){
      container.innerHTML = '<div class="empty">Belum ada siswa terdaftar di kelas ini.</div>';
      return;
    }
    container.innerHTML = list.map(s=>`<div class="student-row"><span>${s.name}</span><span class="x" data-id="${s.id}">&times;</span></div>`).join('');
    container.querySelectorAll('.x').forEach(x=>{
      x.addEventListener('click', async ()=>{
        if(!confirm('Hapus siswa ini dari daftar?')) return;
        students = await fetchStudents();
        students = students.filter(s=>s.id!==x.dataset.id);
        await saveStudents();
        renderStudentList();
      });
    });
  }
  document.getElementById('s-kelas').addEventListener('change', renderStudentList);
  document.getElementById('btn-add-students').addEventListener('click', async ()=>{
    const kelas = document.getElementById('s-kelas').value;
    const raw = document.getElementById('s-bulk').value;
    const names = raw.split('\n').map(n=>n.trim()).filter(Boolean);
    if(names.length===0) return;
    students = await fetchStudents();
    names.forEach(n=>{
      const exists = students.some(s=>s.kelas===kelas && s.name.toLowerCase()===n.toLowerCase());
      if(!exists){ students.push({id: uid('st'), name:n, kelas}); }
    });
    await saveStudents();
    document.getElementById('s-bulk').value='';
    renderStudentList();
  });

  // ---------- INIT ----------
  async function init(){
    fillKelasSelects();
    fillKategoriSelect();
    document.getElementById('in-tanggal').value = todayStr();
    document.getElementById('g-tanggal').value = todayStr();
    document.getElementById('wa-tanggal').value = todayStr();
    document.getElementById('f-tanggal-dari').value = '';
    document.getElementById('f-tanggal-sampai').value = '';
    document.getElementById('gr-dari').value = '';
    document.getElementById('gr-sampai').value = '';
    students = await fetchStudents();
    records = await fetchRecords();
    lastContext = currentContext();
    renderChecklist(true);
  }
  init();
})();
