  async function toggleGuruTask(taskId, checked){
    const {kelas, tanggal} = currentGuruContext();
    const fresh = await fetchGuruLog();
    const sameSlot = r => r.kelas===kelas && r.tanggal===tanggal;
    const others = fresh.filter(r=>!sameSlot(r));
    let slotRecords = fresh.filter(sameSlot);
    if(checked){
      if(!slotRecords.some(r=>r.taskId===taskId)){
        const t = GURU_TASK_MAP[taskId];
        slotRecords.push({id: uid('glog'), kelas, tanggal, taskId, taskLabel: t.label, timestamp: Date.now()});
      }
    }else{
      // "batal": hapus catatan tugas ini saja dari log, bukan seluruh slot
      slotRecords = slotRecords.filter(r=>r.taskId!==taskId);
    }
    const merged = [...others, ...slotRecords];
    await saveGuruLogArr(merged);
  }

